---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import siteData from "../../data/site.json";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: { project },
    }));
}

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, techStack, features, image, demoUrl, githubUrl } =
    project.data;
const { Content } = await project.render();

const pageTitle = `${title} | ${siteData.name}`;
---

<BaseLayout title={pageTitle} description={description} image={image}>
    <!-- Hero Header -->
    <section class="relative py-20 md:py-28 gradient-bg overflow-hidden">
        <!-- Decorative orbs -->
        <div class="floating-orb w-64 h-64 bg-primary-400 -top-10 -left-10">
        </div>
        <div
            class="floating-orb w-48 h-48 bg-secondary-400 bottom-0 right-10"
            style="animation-delay: -3s;"
        >
        </div>

        <div class="container relative z-10">
            <!-- Back Link -->
            <a
                href="/works"
                class="inline-flex items-center gap-2 text-neutral-600 hover:text-primary-600 transition-colors mb-8 group"
            >
                <svg
                    class="w-5 h-5 group-hover:-translate-x-1 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                <span>Back to Projects</span>
            </a>

            <!-- Title & Description -->
            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-neutral-900 via-neutral-800 to-neutral-900 bg-clip-text text-transparent mb-6"
            >
                {title}
            </h1>
            <p
                class="text-lg md:text-xl text-neutral-600 max-w-3xl leading-relaxed mb-8"
            >
                {description}
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4">
                {
                    demoUrl && (
                        <a
                            href={demoUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-primary"
                        >
                            <svg
                                class="w-5 h-5 mr-2"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                />
                            </svg>
                            <span>Live Demo</span>
                        </a>
                    )
                }
                {
                    githubUrl && (
                        <a
                            href={githubUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn btn-secondary"
                        >
                            <svg
                                class="w-5 h-5 mr-2"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                            </svg>
                            <span>View Source</span>
                        </a>
                    )
                }
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <article class="section">
        <div class="container">
            <!-- Project Image -->
            {
                image && (
                    <div class="mb-12 -mt-16 relative z-20">
                        <div class="card-glass p-2 md:p-3 rounded-2xl shadow-2xl">
                            <img
                                src={image}
                                alt={title}
                                class="w-full h-auto rounded-xl"
                            />
                        </div>
                    </div>
                )
            }

            <div class="grid lg:grid-cols-3 gap-8">
                <!-- Sidebar -->
                <aside class="lg:col-span-1 space-y-6">
                    <!-- Tech Stack Card -->
                    <div class="card-glass p-6">
                        <h3
                            class="text-sm font-semibold text-neutral-500 uppercase tracking-wider mb-4"
                        >
                            Tech Stack
                        </h3>
                        <div class="flex flex-wrap gap-2">
                            {
                                techStack.map((tech) => (
                                    <span class="px-3 py-1.5 text-sm font-medium bg-gradient-to-r from-primary-50 to-secondary-50 text-primary-700 rounded-lg border border-primary-100/50">
                                        {tech}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <!-- Features Card -->
                    {
                        features && features.length > 0 && (
                            <div class="card-glass p-6">
                                <h3 class="text-sm font-semibold text-neutral-500 uppercase tracking-wider mb-4">
                                    Key Features
                                </h3>
                                <ul class="space-y-3">
                                    {features.map((feature) => (
                                        <li class="flex items-start gap-3">
                                            <svg
                                                class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M5 13l4 4L19 7"
                                                />
                                            </svg>
                                            <span class="text-sm text-neutral-700">
                                                {feature}
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )
                    }
                </aside>

                <!-- Main Content -->
                <div class="lg:col-span-2">
                    <div class="card-glass p-6 md:p-8">
                        <div class="prose">
                            <Content />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </article>
</BaseLayout>

<style>
    .prose :global(h2) {
        @apply text-2xl font-bold text-neutral-900 mt-10 mb-4 first:mt-0;
    }
    .prose :global(h3) {
        @apply text-xl font-semibold text-neutral-800 mt-8 mb-3;
    }
    .prose :global(p) {
        @apply text-neutral-600 leading-relaxed mb-4;
    }
    .prose :global(ul) {
        @apply list-none space-y-2 text-neutral-600 mb-4 pl-0;
    }
    .prose :global(li) {
        @apply leading-relaxed relative pl-6;
    }
    .prose :global(li)::before {
        content: "";
        @apply absolute left-0 top-2.5 w-1.5 h-1.5 bg-primary-500 rounded-full;
    }
    .prose :global(strong) {
        @apply text-neutral-800 font-semibold;
    }
    .prose :global(code) {
        @apply bg-neutral-100 px-1.5 py-0.5 rounded text-sm font-mono text-primary-700;
    }
    .prose :global(pre) {
        @apply bg-neutral-900 text-neutral-100 p-4 rounded-xl overflow-x-auto mb-4;
    }
    .prose :global(pre code) {
        @apply bg-transparent p-0 text-inherit;
    }
    .prose :global(a) {
        @apply text-primary-600 hover:text-primary-700 underline decoration-primary-300 hover:decoration-primary-500 transition-colors;
    }
</style>
